# PostgreSQL（docker compose up -d で起動）。本番（Neon / Supabase）では「プール（pooler）」の接続文字列
DATABASE_URL="postgresql://eigo:eigo@localhost:5432/eigo_quest?schema=public"
# マイグレーション（npx prisma migrate deploy）用の 直接の接続。ローカルでは DATABASE_URL と同じでよい（下の書き方のまま）
# 本番（Neon / Supabase）では プールを通さない「direct」の接続文字列（docs/run5/DEPLOY.md）
DIRECT_URL="${DATABASE_URL}"
# 筆記テストAI採点（Claude API）。未設定ならルールベース採点のみで動作
ANTHROPIC_API_KEY=""
# レッスンさいごの AIキャラとの かいわ に使うモデル（未設定なら claude-haiku-5-5）。キーが無いときは台本の返事で動作
CONVERSATION_MODEL="claude-haiku-5-5"
# 日付の区切り（毎日1レッスン判定）に使うタイムゾーン
APP_TIMEZONE="Asia/Tokyo"
# 収録音声（public/media/audio/{audioKey}.mp3）を置いたら 1。未設定ならブラウザの読み上げだけ（ないファイルを取りにいかない）
NEXT_PUBLIC_RECORDED_AUDIO=""
# 保護者アカウント: 同じホスト以外から POST/PATCH/DELETE を受け付けるオリジン（カンマ区切り。通常は空でよい）
ALLOWED_ORIGINS=""
# 1 にすると seed で開発用のデモ保護者（demo-parent@example.com / demo-pass-1234 / PIN 1234）を作る。本番では空のまま
SEED_DEMO_PARENT=""
# LINE ログイン（保護者）。LINE Developers の「LINE ログイン」チャネルの値。3つそろったときだけ「LINEでログイン」を表示する（空なら非表示）
LINE_LOGIN_CHANNEL_ID=""
LINE_LOGIN_CHANNEL_SECRET=""
# コールバック URL（LINE Developers に登録するものと同じ）。例: https://example.com/api/auth/line/callback（開発: http://localhost:3000/api/auth/line/callback）
LINE_LOGIN_CALLBACK_URL=""
# LINE 公式アカウント（Messaging API チャネル）: 月ごとの学習レポート（PDF のリンク）を保護者に送る。
# LINE ログインのチャネルと「同じプロバイダー」に作ること（ちがうとユーザーIDが一致せず届かない）。
# アクセストークン（長期）。空なら送らずに outbox へ書くだけ（dry-run）
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=""
# チャネルシークレット。webhook（/api/line/webhook）の署名の確認に使う。空なら webhook は受け付けない
LINE_MESSAGING_CHANNEL_SECRET=""
# メッセージ・メールに入れるリンクのもと（公開している URL）。例: https://example.com
# 空なら LINE には送らない。メール（パスワード再設定など）は、開発中だけ 開いているサイトの URL を使い、本番（NODE_ENV=production）では送らない
APP_BASE_URL=""
# メール（パスワードの再設定・メールアドレスの確認）の送り方: resend | smtp | outbox
# 空なら RESEND_API_KEY があれば resend → SMTP_URL があれば smtp → どちらも無ければ outbox（送らずに MAIL_OUTBOX_DIR へ書く。開発用）
MAIL_PROVIDER=""
# 差出人。resend / smtp では必須（例: 英語クエスト <no-reply@example.com>。送信サービスで認証したドメインのアドレス）
MAIL_FROM=""
# Resend の API キー（MAIL_PROVIDER=resend のとき）
RESEND_API_KEY=""
# SMTP の接続先（MAIL_PROVIDER=smtp のとき）。例: smtps://user:pass@smtp.example.com:465
SMTP_URL=""
# outbox のときにメールを書くフォルダ（空なら <プロジェクト>/.data/mail-outbox）
MAIL_OUTBOX_DIR=""
# 配信する PDF（学習レポート・ワークブック）の置き場所: local | s3
# 空なら S3_BUCKET があれば s3、なければ local。Vercel などのサーバーレスでは ファイルが残らないので s3 にする
STORAGE_DRIVER=""
# local のときのフォルダ（空なら <プロジェクト>/.data/reports）
REPORT_STORAGE_DIR=""
# s3 のとき（S3 互換: AWS S3・Cloudflare R2・Supabase Storage の S3 API など）。バケットは「非公開」で作ること
S3_BUCKET=""
# リージョン。空なら S3_ENDPOINT があれば auto（R2）、なければ us-east-1。Supabase はプロジェクトのリージョン（例: ap-northeast-1）
S3_REGION=""
# AWS 以外のときの エンドポイント。例: https://<アカウントID>.r2.cloudflarestorage.com ／ https://<プロジェクト>.supabase.co/storage/v1/s3
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# パス形式の URL にするか（1/0）。空なら S3_ENDPOINT があれば 1（R2・Supabase）、なければ 0（AWS）
S3_FORCE_PATH_STYLE=""
# すべてのキーの前につける フォルダ名（例: eigo-quest/。空でよい）
S3_PREFIX=""
# dry-run のときにメッセージと PDF を書くフォルダ（空なら <プロジェクト>/.data/line-outbox。サーバーレスでは書けないので書かずに続ける）
LINE_OUTBOX_DIR=""
# 定期実行（/api/cron/line-monthly・/api/cron/trial-cleanup）の合い言葉（16文字以上のランダムな文字列）。
# Vercel Cron Jobs は「Authorization: Bearer <CRON_SECRET>」を付けて呼ぶ。空なら cron の API は何もしない（503）
CRON_SECRET=""
# ビルド（npm run vercel-build）で prisma migrate deploy を流すか: 1 = 流す / 0 = 流さない / 空 = Vercel の本番デプロイ（VERCEL_ENV=production）だけ
MIGRATE_ON_BUILD=""
