{
  "name": "eigo-quest",
  "version": "0.1.0",
  "private": true,
  "description": "6〜12歳向け 毎日つづける・ゲーミフィケーション英語学習アプリ（学校テスト対策 × フォニックス × 反射神経）",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "node scripts/vercel-build.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "curriculum:index": "tsx scripts/curriculum-index.ts",
    "curriculum:check": "tsx scripts/curriculum-index.ts --check",
    "teacher:merge": "tsx scripts/teacher-merge.ts",
    "teacher:screens": "tsx scripts/teacher-screens.ts",
    "teacher:export": "tsx scripts/teacher-export.ts",
    "teacher:link": "tsx scripts/teacher-link.ts",
    "library:index": "tsx scripts/library-index.ts",
    "library:check": "tsx scripts/library-index.ts --check",
    "yearly:check": "tsx scripts/yearly-check.ts",
    "worksheets": "python3 worksheets/generate_worksheets.py --all",
    "worksheets:month": "python3 worksheets/generate_worksheets.py --month",
    "worksheets:upload": "tsx scripts/upload-worksheets.ts",
    "db:deploy": "prisma migrate deploy",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:offline": "tsx scripts/smoke-offline.ts",
    "check:auth-db": "tsx scripts/auth-db-check.ts",
    "check:line-db": "tsx scripts/line-db-check.ts",
    "line:monthly": "tsx scripts/line-monthly.ts",
    "trial:cleanup": "tsx scripts/cleanup-trial.ts",
    "check:line-monthly-db": "tsx scripts/line-monthly-db-check.ts",
    "check:run4-flow": "tsx scripts/run4-flow-check.ts",
    "check:reset-db": "tsx scripts/reset-db-check.ts",
    "check:run5-flow": "tsx scripts/run5-flow-check.ts",
    "screens:auth": "tsx scripts/auth-ui-screens.ts",
    "english:lint": "tsx scripts/english-lint.ts",
    "english:reports": "tsx scripts/english-reports.ts",
    "check:all": "tsx scripts/check-all.ts",
    "check:data": "tsx scripts/data-check.ts",
    "check:render": "tsx --tsconfig scripts/tsconfig.json scripts/render-check.ts",
    "check:a11y": "tsx scripts/a11y-check.ts",
    "check:links": "tsx scripts/link-check.ts",
    "check:bundle": "tsx scripts/bundle-budget.ts",
    "check:e2e": "tsx scripts/e2e-check.ts",
    "phrasebook:doc": "tsx scripts/phrasebook-doc.ts",
    "phrasebook:fix": "tsx scripts/phrasebook-fix.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^6.6.0",
    "next": "15.3.2",
    "nodemailer": "^6.10.1",
    "pdf-lib": "^1.17.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.24",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "axe-core": "^4.14.1",
    "cspell": "^10.5.2",
    "cspell-lib": "^10.5.2",
    "embedded-postgres": "^16.16.0-beta.19",
    "playwright": "^1.65.1",
    "prisma": "^6.6.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
