datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String           @id @default(cuid())
  parentId         String?
  parent           User?            @relation("ParentChildren", fields: [parentId], references: [id])
  children         User[]           @relation("ParentChildren")
  nickname         String
  birthYear        Int?
  schoolGrade      Int?
  friendCode       String           @unique
  avatar         String   @default("{}")
  coins            Int              @default(0)
  totalCoinsEarned Int              @default(0)
  streakDays       Int              @default(0)
  longestStreak    Int              @default(0)
  lastStudyDate    String?
  createdAt        DateTime         @default(now())
  lessonProgress   LessonProgress[]
  testAttempts     TestAttempt[]
  responses        ItemResponse[]
  memories         ItemMemory[]
  coinLedger       CoinLedger[]
  reviewAlerts     ReviewAlert[]
  monsters         UserMonster[]
  gachaTickets     GachaTicket[]
  items            UserShopItem[]
  snapshots        MasterySnapshot[]
  friendsFrom      Friendship[]     @relation("FriendFrom")
  friendsTo        Friendship[]     @relation("FriendTo")
}

model Friendship {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("FriendFrom", fields: [userId], references: [id])
  friendId  String
  friend    User     @relation("FriendTo", fields: [friendId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, friendId])
}

model Lesson {
  lessonNo     Int            @id
  title        String
  category     String
  items        LearningItem[]
  progress     LessonProgress[]
}

enum ItemKind {
  WORD
  SENTENCE
  PHONICS
}

model LearningItem {
  id           String         @id
  lessonNo     Int
  lesson       Lesson         @relation(fields: [lessonNo], references: [lessonNo])
  kind         ItemKind
  text         String
  ja           String
  emoji        String?
  skills         String   /// JSON縺ｨ縺励※菫晏ｭ・  schoolCore   Boolean        @default(false)
  responses    ItemResponse[]
  memories     ItemMemory[]

  @@index([lessonNo])
}

enum AssessmentKind {
  SCHOOL_TEST
  PHONICS
  LISTENING
  SPEAKING
  VOCABULARY
  WRITING
}

model Assessment {
  id            String          @id
  kind          AssessmentKind
  rangeStart    Int
  rangeEnd      Int
  questionCount Int
  passRate      Float
  unlocksLesson Int?
  attempts      TestAttempt[]
}

enum LessonStatus {
  IN_PROGRESS
  COMPLETED
}

model LessonProgress {
  lesson         Lesson       @relation(fields: [lessonNo], references: [lessonNo])
  userId             String
  lessonNo           Int
  user               User         @relation(fields: [userId], references: [id])
  status             LessonStatus @default(IN_PROGRESS)
  startedAt          DateTime     @default(now())
  completedAt        DateTime?
  completedOn        String?
  quizScore          Float?
  speedListeningBest Float?

  @@id([userId, lessonNo])
}

enum AttemptSource {
  NORMAL
  REVIEW
  ARENA
  BOSS
}

model TestAttempt {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  assessmentId String
  assessment   Assessment    @relation(fields: [assessmentId], references: [id])
  score        Float
  passed       Boolean
  createdAt    DateTime      @default(now())
}

model ItemResponse {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  itemId       String
  item         LearningItem  @relation(fields: [itemId], references: [id])
  skill        String
  questionType String
  correct      Boolean
  score        Float?
  responseMs   Int?
  playbackRate Float?
  answer       String?
  context      AttemptSource @default(NORMAL)
  attemptId    String?
  createdAt    DateTime      @default(now())

  @@index([userId, itemId, createdAt])
  @@index([userId, skill, createdAt])
}

model ItemMemory {
  userId         String
  itemId         String
  user           User         @relation(fields: [userId], references: [id])
  item           LearningItem @relation(fields: [itemId], references: [id])
  stability      Float
  difficulty     Float
  reviewCount    Int          @default(0)
  lapses         Int          @default(0)
  accuracyEwma   Float        @default(0)
  lastReviewedAt DateTime

  @@id([userId, itemId])
}

enum CoinReason {
  LESSON_CLEAR
  TEST_PASS
  GACHA_SPEND
  SHOP_BUY
  STREAK_BONUS
}

model CoinLedger {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id])
  amount         Int
  reason         CoinReason
  multiplier     Float      @default(1)
  refType        String?
  refId          String?
  idempotencyKey String     @unique
  createdAt      DateTime   @default(now())

  @@index([userId, createdAt])
}

enum AlertStatus {
  OFFERED
  EXPIRED
  CLEARED
}

model ReviewAlert {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  lessonNo       Int
  itemIds        String   /// JSON縺ｨ縺励※菫晏ｭ・  retrievability Float
  multiplier     Float       @default(2)
  status         AlertStatus @default(OFFERED)
  offeredOn      String
  expiresAt      DateTime
  clearedAt      DateTime?
  createdAt      DateTime    @default(now())

  @@index([userId, offeredOn])
}

model GachaTicket {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserMonster {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  monsterId String
  unlockedAt DateTime @default(now())
}

model ShopItem {
  id          String         @id
  slot        String
  name        String
  price       Int
  userItems   UserShopItem[]
}

model UserShopItem {
  id       String   @id @default(uuid())
  userId   String
  itemId   String
  boughtAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id])
  item     ShopItem @relation(fields: [itemId], references: [id])
}

model MasterySnapshot {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date      String
  mastery   Float
  createdAt DateTime @default(now())
}
